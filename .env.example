APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# In production set to ".overlabels.com" so private channels work across overlabels.com and ws.overlabels.com
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Broadcast metering. Set BROADCAST_CONNECTION=metered (above) to count every
# outbound Reverb broadcast per user. Leave METERING_FREE_MONTHLY_BROADCASTS
# empty for observe-only (count + display, no cap); set a number to turn on the
# free-tier ceiling UI.
# METERING_ENABLED=true
# METERING_FREE_MONTHLY_BROADCASTS=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 - target for `php artisan backup:database`. Only production
# needs these; locally you would normally run the command with --disk=local or
# just pull an existing dump down. See docs/deploy/restore.md.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=overlabels-backups
R2_JURISDICTION=eu

# Cloudflare R2 - user-facing image storage (template screenshots, kit
# thumbnails), served publicly from images.overlabels.com. A SEPARATE bucket
# and a separate API token from the backup pair above: this one is reachable
# from a web request, so a leak of it must not reach the backups.
#
# R2_IMAGES_ACCOUNT_ID and R2_IMAGES_JURISDICTION fall back to R2_ACCOUNT_ID
# and `eu`, so a single-account setup only needs the key, the secret and the
# bucket. R2_IMAGES_URL must match the custom domain attached to the bucket in
# the Cloudflare dashboard - it is persisted into every stored image URL.
# See docs/deploy/image-storage.md.
R2_IMAGES_ACCESS_KEY_ID=
R2_IMAGES_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=overlabels-images
R2_IMAGES_URL=https://images.overlabels.com

# Scaleway Object Storage - the second copy of the same daily dump, so that
# no single provider account holds every backup. Only the access key and secret
# are used: Scaleway's S3-compatible API resolves the project from the key, so
# their CLI's SCW_DEFAULT_ORGANIZATION_ID / SCW_DEFAULT_PROJECT_ID are not
# needed here. SCW_REGION is part of the endpoint hostname.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET=
SCW_REGION=fr-par

# Destinations for `php artisan backup:database`, comma separated. Every disk
# listed is attempted, and the run fails if any of them does not land. Locally
# you would normally override with --disk=local rather than change this.
BACKUP_DISKS=r2,scaleway

# Discord webhook shouted at when a daily backup fails. Empty = log only.
BACKUP_ALERT_WEBHOOK_URL=
# Healthchecks.io ping URL for the daily backup dead-man's switch.
# Empty = no pings registered. Only production needs this.
HC_PING_URL=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="${APP_URL}"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Discord webhook URL for integration suggestion notifications
INTEGRATION_SUGGESTION_WEBHOOK_URL=

# Sqids alphabet for public map slugs. Must be 62 unique chars. Keep stable
# across deploys or every previously shared /map/{slug} URL stops resolving.
MAP_SLUG_ALPHABET=
MAP_SLUG_MIN_LENGTH=8

# Twitch (main app) - OAuth + EventSub. Required for Twitch integration.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# Twitch bot (@overlabels shared account) - separate Twitch Developer app
TWITCHBOT_CLIENT_ID=
TWITCHBOT_CLIENT_SECRET=
TWITCHBOT_REDIRECT_URI=
TWITCHBOT_LISTENER_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_HOST="${APP_URL}"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# Synthetic chat firehose for load-testing the overlay renderer. DEV ONLY.
#
# Read by Vite at BUILD time, not at runtime, so it must be set for the build
# command rather than just present in the environment:
#
#   VITE_CHAT_HOSE=1 npm run build
#
# Then open an overlay and drive it from the console:
#
#   __olChatHose.start({ rate: 50 })   # messages per second
#   __olChatHose.burst(500)            # instant spike, like a raid
#   __olChatHose.stop()                # prints sent count, achieved rate,
#                                      # average FPS and dropped-frame count
#
# Leave this unset for any build that ships. An ordinary build eliminates the
# module entirely, and DevToolsExcludedFromBuildTest fails if it ever does not.
# VITE_CHAT_HOSE=1
