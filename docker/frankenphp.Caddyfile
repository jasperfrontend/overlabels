# FrankenPHP Caddyfile for Overlabels (Laravel 12)
#
# kamal-proxy terminates TLS, forwards plain HTTP to this server on :80.
# SERVER_NAME=:80 makes Caddy listen on plain HTTP without trying to provision
# its own LE cert (kamal-proxy already did).

{
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp
	order php_server before file_server
	auto_https off
	servers {
		# Caddy walks X-Forwarded-For right to left and stops at the first hop
		# it does NOT trust, calling that the client. kamal-proxy is on the
		# docker bridge so private_ranges covers it - but once overlabels.com
		# and www went orange-clouded on 2026-08-19 there was a second hop, the
		# Cloudflare edge, which is public. Caddy stopped there and every
		# request in the app resolved to a Cloudflare IP: sessions, banhammer
		# IP bans, the 100/min overlay rate limiter (all users sharing one
		# bucket per PoP) and every audit log. Nothing in PHP was wrong; it was
		# being handed the wrong address.
		#
		# The list must stay EXPLICIT. `*` would trust anything, and the origin
		# still answers directly on its Linode IP, so anyone could then spoof
		# X-Forwarded-For and walk straight past an IP ban. With real ranges, a
		# direct request comes from an untrusted peer and Caddy ignores its
		# headers in favour of the actual TCP address.
		#
		# Source: https://www.cloudflare.com/ips-v4 and /ips-v6, fetched
		# 2026-08-19. Cloudflare changes these on a timescale of years, but if
		# client IPs ever look wrong again, re-check this list first.
		trusted_proxies static private_ranges \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$SERVER_NAME::80} {
	root * /app/public
	encode zstd br gzip

	log {
		output stderr
		format console
	}

	# www exists only to redirect. kamal-proxy terminates TLS for it (see the
	# `hosts:` list in config/deploy.yml) and forwards here with the original
	# Host header intact; without this the app would serve on a second hostname
	# and split every canonical URL. {uri} keeps path and query, so
	# www.overlabels.com/llms.txt lands on the file rather than the homepage.
	@www host www.overlabels.com
	redir @www https://overlabels.com{uri} 301

	# Machine-readable docs are fetched cross-origin by browser-context agents
	# (in-page tooling, extensions, sandboxed LLM clients), which get a CORS
	# failure without this. Everything matched here is public and
	# unauthenticated already, so `*` gives away nothing a plain GET doesn't.
	# Note this does NOT help agents whose sandbox blocks the host outright -
	# that is an egress allowlist on their side, not a header we can send.
	# A regexp rather than a `path` list because Caddy's path wildcard does not
	# cross a `/`: `/help/*.md` matches /help/controls.md but silently misses
	# /help/bot/expressions.md and /help/bot/aliases.md. This holds at any depth,
	# so a future nested page is covered without touching this file.
	@machine_readable path_regexp ^/(llms\.txt|help(/[\w-]+)*\.md)$
	header @machine_readable Access-Control-Allow-Origin "*"

	php_server
}
